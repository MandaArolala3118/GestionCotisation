# URL du projet Supabase (Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé "service_role" du projet Supabase (Project Settings > API)
# ATTENTION : cette clé est secrète, ne jamais l'exposer côté client
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chaîne aléatoire longue utilisée pour signer les sessions de connexion
# Génère-en une avec : openssl rand -base64 48
SESSION_SECRET=remplace_moi_par_une_valeur_longue_et_aleatoire

# Configuration SMTP pour l'envoi d'emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_email@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_application
SMTP_FROM=votre_email@gmail.com
