# URL du projet Supabase (Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé "service_role" du projet Supabase (Project Settings > API)
# ATTENTION : cette clé est secrète, ne jamais l'exposer côté client
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chaîne aléatoire longue utilisée pour signer les sessions de connexion
# Génère-en une avec : openssl rand -base64 48
SESSION_SECRET=remplace_moi_par_une_valeur_longue_et_aleatoire

# Configuration API Gmail pour l'envoi d'emails
# Suivez les instructions ci-dessous pour obtenir ces valeurs :
# 1. Allez sur https://console.cloud.google.com/
# 2. Créez un nouveau projet ou sélectionnez-en un existant
# 3. Activez l'API Gmail (APIs & Services > Library > Gmail API)
# 4. Créez des identifiants OAuth 2.0 (APIs & Services > Credentials)
# 5. Type d'application : Application Web
# 6. URIs de redirection autorisés : https://developers.google.com/oauthplayground
# 7. Notez le Client ID et Client Secret
# 8. Allez sur https://developers.google.com/oauthplayground/
# 9. Cliquez sur le gear icon > Use your own OAuth credentials
# 10. Entrez votre Client ID et Client Secret
# 11. Sélectionnez Gmail API > https://www.googleapis.com/auth/gmail.send
# 12. Cliquez sur Authorize APIs, puis Exchange authorization code for tokens
# 13. Copiez le Refresh Token
GMAIL_CLIENT_ID=votre_client_id
GMAIL_CLIENT_SECRET=votre_client_secret
GMAIL_REFRESH_TOKEN=votre_refresh_token
GMAIL_EMAIL=votre_email@gmail.com
